# Environment Variables
PORT=3000
NODE_ENV=development

# File Upload Settings
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=100
UPLOAD_PATH=./uploads

# Security
CORS_ORIGIN=http://localhost:5173

